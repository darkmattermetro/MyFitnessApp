# Copia este archivo a .env y completa los valores.
# Los valores reales NO se suben a git (ver .gitignore).
# URL del proyecto: https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE_ANON

# Modo demo: sin base de datos, todo en storage local (localStorage en web).
# true → fuerza modo demo. false → fuerza producción.
# Si no se define, entra en demo SOLO cuando Supabase no está configurado.
EXPO_PUBLIC_DEMO_MODE=false