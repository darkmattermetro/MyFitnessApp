# Copy this file to .env and fill in the values.
# Real values are NOT committed to git (see .gitignore).
# Project URL: https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY

# Demo mode: no database, everything in local storage (localStorage on web).
# true → force demo mode. false → force production.
# If unset, demo mode turns on ONLY when Supabase is not configured.
EXPO_PUBLIC_DEMO_MODE=false
