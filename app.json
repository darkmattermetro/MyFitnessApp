{
  "expo": {
    "name": "OpenFit",
    "slug": "fit",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "openfit",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1114",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tucas.fit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tucas.fit",
      "versionCode": 4,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1114",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenFit uses your photos to describe and log the meals you eat.",
          "cameraPermission": "OpenFit uses the camera to photograph and log the meals you eat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1114",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "OpenFit uses your phone's motion sensor to count your steps."
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenFit uses the camera to photograph and estimate meals.",
          "microphonePermission": false
        }
      ],
      "./plugins/withHealthConnectRationale",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "092b168f-928c-4b2b-b3a1-b6cf0a138be5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/092b168f-928c-4b2b-b3a1-b6cf0a138be5"
    }
  }
}
