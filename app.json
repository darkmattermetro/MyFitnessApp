{
  "expo": {
    "name": "OpenFit",
    "slug": "fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "openfit",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F7F9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tucas.fit"
    },
    "android": {
      "package": "com.tucas.fit",
      "versionCode": 1,
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#044134",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenFit uses your photos to describe and log the meals you eat.",
          "cameraPermission": "OpenFit uses the camera to photograph and log the meals you eat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#044134",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "OpenFit uses your phone's motion sensor to count your steps."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "7a93b2a8-ac78-4b78-a6b7-902c0d06009a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7a93b2a8-ac78-4b78-a6b7-902c0d06009a"
    }
  }
}
